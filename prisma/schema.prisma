generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String               @id @default(cuid())
  clerkUserId              String               @unique
  email                    String               @unique
  firstName                String?
  lastName                 String?
  imageUrl                 String?
  role                     UserRole             @default(UNASSIGNED)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  credits                  Int                  @default(0)
  currentPlan              String               @default("free")
  creditsLastAllocatedAt   DateTime?
  lastProcessedPeriodStart DateTime?
  bio                      String?
  designation              String?
  company                  String?
  experience               Int?
  expertise                InterviewExpertise[]
  creditRate               Int                  @default(1)
  creditBalance            Int                  @default(0)
  averageRating            Float?
  totalRatings             Int                  @default(0)
  phone                    String?
  status                   UserStatus           @default(ACTIVE)
  availabilities           Availability[]
  bookingsAsCandidate      Booking[]            @relation("CandidateBookings")
  bookingsAsInterviewer    Booking[]            @relation("InterviewerBookings")
  transactions             CreditTransaction[]
  payouts                  Payout[]
  subscriptions            Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  cashfreeSubId      String             @unique
  cashfreePlanId     String
  planSlug           String
  status             SubscriptionStatus @default(INITIALIZED)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  customerPhone      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([cashfreeSubId])
}

model Availability {
  id            String             @id @default(uuid())
  interviewerId String
  startTime     DateTime
  endTime       DateTime
  status        AvailabilityStatus @default(AVAILABLE)
  interviewer   User               @relation(fields: [interviewerId], references: [id], onDelete: Cascade)

  @@index([interviewerId, startTime])
}

model Booking {
  id               String              @id @default(uuid())
  candidateId      String
  interviewerId    String
  startTime        DateTime
  endTime          DateTime
  status           BookingStatus       @default(SCHEDULED)
  completionReason CompletionReason?
  streamStatus     StreamStatus        @default(READY)
  creditsCharged   Int
  streamCallId     String?             @unique
  recordingUrl     String?
  isRefunded       Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  candidate        User                @relation("CandidateBookings", fields: [candidateId], references: [id])
  interviewer      User                @relation("InterviewerBookings", fields: [interviewerId], references: [id])
  sessions         BookingSession[]
  transactions     CreditTransaction[]
  feedback         Feedback?
  review           Review?

  @@index([status, createdAt])
  @@index([interviewerId, status])
  @@index([candidateId, status])
}

model Feedback {
  id             String         @id @default(uuid())
  bookingId      String         @unique
  summary        String
  technical      String
  communication  String
  problemSolving String
  recommendation String
  strengths      String[]
  improvements   String[]
  overallRating  FeedbackRating
  createdAt      DateTime       @default(now())
  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id        String            @id @default(uuid())
  userId    String
  amount    Int
  type      TransactionType
  reason    CompletionReason?
  bookingId String?
  createdAt DateTime          @default(now())
  booking   Booking?          @relation(fields: [bookingId], references: [id])
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payout {
  id            String       @id @default(uuid())
  interviewerId String
  credits       Int
  platformFee   Float
  netAmount     Float
  status        PayoutStatus @default(PROCESSING)
  adminNote     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  processedAt   DateTime?
  processedBy   String?
  interviewer   User         @relation(fields: [interviewerId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([interviewerId, status])
}

model BookingSession {
  id                         String   @id @default(uuid())
  bookingId                  String
  streamSessionId            String
  coPresenceSeconds          Int      @default(0)
  interviewerPresenceSeconds Int      @default(0)
  candidatePresenceSeconds   Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  booking                    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, streamSessionId])
  @@index([bookingId])
}

model PlatformConfig {
  id                 String   @id @default(uuid())
  creditPayoutRate   Float
  platformFeePercent Float
  minPayoutCredits   Int
  currency           String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum UserRole {
  UNASSIGNED
  CANDIDATE
  INTERVIEWER
}

enum BookingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum CompletionReason {
  MUTUAL
  CANDIDATE_NO_SHOW
}

enum StreamStatus {
  READY
  PENDING
  FAILED
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum PayoutStatus {
  PROCESSING
  PROCESSED
  REJECTED
}

enum InterviewExpertise {
  FRONTEND
  BACKEND
  FULLSTACK
  DEVOPS
  DSA
  SYSTEM_DESIGN
  MOBILE
  ML_AI
  SECURITY
  QA
  CLOUD
}

enum FeedbackRating {
  POOR
  AVERAGE
  GOOD
  EXCELLENT
}

enum TransactionType {
  CREDIT_PURCHASE
  BOOKING_DEDUCTION
  BOOKING_EARNING
  ADMIN_ADJUSTMENT
  BOOKING_REFUND
  BOOKING_REVERSAL
}

enum SubscriptionStatus {
  INITIALIZED
  BANK_APPROVAL_PENDING
  ACTIVE
  ON_HOLD
  PAUSED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum UserStatus {
  ACTIVE
  BANNED
}
